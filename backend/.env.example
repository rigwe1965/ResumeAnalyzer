GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Required: random string, 32+ chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string_32chars_min
# Optional: token lifetime in minutes (default 720)
# JWT_EXPIRE_MINUTES=720
